# Cresco web — public configuration only. Never put server secrets here:
# no PYTH_PRO_API_KEY, no signer keys, no backend tokens.

# KEYS API. Local dev uses the same-origin relay in next.config.ts (/keys-api → KEYS_API_UPSTREAM).
# Production (cresco-lac.vercel.app) calls the hosted Worker directly (CORS allows that origin).
NEXT_PUBLIC_KEYS_API_URL=/keys-api
KEYS_API_UPSTREAM=https://keys-api-stocklana.faadil-casecraft.workers.dev

# "runtime" enables the Practice lane on Solana Devnet (POST /api/v0.2/actions/execute, demo-token
# practice capital, no real value). Unset = Practice uses the local sandbox only.
NEXT_PUBLIC_KEYS_EXECUTION=runtime

# Money = Solana Mainnet. Public program id only; it does NOT enable Money by itself.
# Money goes live only when the Mainnet program, verified guardian, verified asset route,
# execution provider and real funding all exist (apps/web/src/domain/network.ts).
NEXT_PUBLIC_KEYS_MAINNET_PROGRAM_ID=

# Backend (Cloudflare Worker) secrets live in `wrangler secret`, never here:
#   SOLANA_DEVNET_RPC_URL, SOLANA_DEVNET_RPC_FALLBACK_URLS, DEVNET_KEYPAIR_JSON, PYTH_PRO_API_KEY

# Optional embedded wallet (Privy: email / Google / Apple + Solana embedded wallet).
# Create an app at https://dashboard.privy.io, enable Solana embedded wallets, and add your
# origins (http://localhost:3210, https://cresco-lac.vercel.app). Unset = wallet UI hidden.
# The wallet is identity only; it never grants Money Mode authority.
NEXT_PUBLIC_PRIVY_APP_ID=
